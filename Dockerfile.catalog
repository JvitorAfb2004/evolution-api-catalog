# Overlay do dist já compilado sobre a imagem oficial.
# Motivo: compilar (npm ci + tsup) dentro da VPS estourava RAM e derrubava o servidor.
# Fonte do codigo: https://github.com/JvitorAfb2004/evolution-api-catalog
FROM evoapicloud/evolution-api:v2.3.7

COPY prebuilt /evolution/dist

# O token de ad-account do catalogo depende do push <wa_ad_account_nonce>.
# O patch (idempotente) faz o Baileys emitir o evento business.ctwa-nonce.
COPY tools/patch-baileys-nonce.js /tmp/patch-baileys-nonce.js
RUN node /tmp/patch-baileys-nonce.js /evolution/node_modules/baileys/lib/Socket/messages-recv.js

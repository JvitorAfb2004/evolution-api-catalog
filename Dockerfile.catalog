# Overlay do dist já compilado sobre a imagem oficial.
# Motivo: compilar (npm ci + tsup) dentro da VPS estourava RAM e derrubava o servidor.
# Fonte do codigo: https://github.com/JvitorAfb2004/evolution-api-catalog
FROM evoapicloud/evolution-api:v2.3.7

COPY prebuilt /evolution/dist

# TEMPORARIO (diagnostico): instrumenta o productCreate do Baileys para expor o JSON cru.
COPY tools/patch-baileys-catalog.js /tmp/patch-baileys-catalog.js
RUN node /tmp/patch-baileys-catalog.js
